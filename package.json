{
  "name": "travel-solid",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"deno task dev:db\" \"deno task dev:app\"",
    "dev:app": "deno run --allow-env --allow-sys --allow-ffi --env-file --allow-net --allow-read --allow-write --allow-run npm:vinxi dev --port 3030",
    "prod": "deno run --allow-env --allow-sys --allow-ffi --env-file=.env.prod --allow-net --allow-read --allow-write --allow-run npm:vinxi dev --port 3030",
    "dev:db": "turso dev --db-file local.db",
    "build": "deno run --allow-env --allow-read --allow-sys --allow-run --allow-ffi --allow-write npm:vinxi build",
    "build:prod": "bunx vinxi build",
    "start": "deno run --allow-net --allow-read --allow-write --allow-env --allow-sys ./.output/server/index.mjs",
    "version": "vinxi version",
    "check": "deno fmt --check ./src/ && deno lint ./src/ && deno check ./src/",
    "db:generate": "pnpm drizzle-kit generate",
    "db:migrate": "pnpm drizzle-kit migrate",
    "db:studio": "pnpm drizzle-kit studio",
    "auth:generate": "pnpm dlx @better-auth/cli generate --config ./src/shared/auth.ts"
  },
  "dependencies": {
    "@corvu/calendar": "^0.1.2",
    "@corvu/drawer": "^0.2.4",
    "@hono/zod-openapi": "^1.2.2",
    "@kobalte/core": "^0.13.11",
    "@libsql/client": "^0.17.0",
    "@scalar/hono-api-reference": "^0.9.40",
    "@solidjs/meta": "^0.29.4",
    "@solidjs/router": "^0.15.4",
    "@solidjs/start": "^1.2.1",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/solid-form": "^1.28.3",
    "better-auth": "^1.4.18",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^9.2.1",
    "drizzle-orm": "^0.45.1",
    "drizzle-zod": "^0.8.3",
    "embla-carousel-solid": "^8.6.0",
    "hono": "^4.11.9",
    "hono-pino": "^0.10.3",
    "hono-rate-limiter": "^0.5.3",
    "lucide-solid": "^0.564.0",
    "maplibre-gl": "^5.18.0",
    "nanoid": "^5.1.6",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "slug": "^11.0.1",
    "solid-js": "^1.9.11",
    "solid-maplibre": "^0.5.0",
    "solid-sonner": "^0.2.8",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.18",
    "tailwindcss-animate": "^1.0.7",
    "vinxi": "^0.5.11",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@kobalte/tailwindcss": "^0.9.0",
    "@types/slug": "^5.0.9",
    "drizzle-kit": "^0.31.9"
  },
  "engines": {
    "node": ">=22"
  }
}
